// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/assets/alien.gif",
        "width": 22,
        "padding": {
            "top": 1,
            "right": 4,
            "left": 3
        }
    },
    "display": {
        "separator": " ",
        "size": {
            "binaryPrefix": "SI"
        }
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#32}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "type": "command",
            "key": "│ {#33}󱦟 os age  {#keys}│",
            "keyColor": "magenta",
            "text": "printf \"\\e[0m%s days\\e[0m\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\""
        },
        {
            "key": "│ {#34}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#34}{icon}distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#35}  kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#36}  wm      {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#31}  term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#32}  shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#33}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#34}󰍹 gpu     {#keys}│",
            "type": "gpu",
            "detectionMethod": "pci"
        },
        {
            "key": "│ {#34}󰉉 disk /  {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#34}󰉉 ssd2    {#keys}│",
            "type": "disk",
            "folders": "/mnt/seccondSSD"
        },
        {
            "key": "│ {#34}󰉉 hdd1    {#keys}│",
            "type": "disk",
            "folders": "/mnt/hdd1"
        },
        {
            "key": "│ {#34}󰉉 hdd2    {#keys}│",
            "type": "disk",
            "folders": "/mnt/hdd2"
        },
        {
            "key": "│ {#36}  memory  {#keys}│",
            "type": "memory"
        },
        {
            "type": "command",
            "key": "│ {#33}󰏖 pkgs    {#keys}│",
            "keyColor": "magenta",
            "text": "printf \"\\e[0m%s\\e[0m\" \"$(( $(pacman -Qq | wc -l) + $(flatpak list --app 2>/dev/null | wc -l) ))\""
        },
        {
            "type": "command",
            "key": "│ {#34}󰏖 repo    {#keys}│",
            "keyColor": "magenta",
            "text": "printf \"\\e[0m%s\\e[0m\" \"$(pacman -Qqn | wc -l)\""
        },
        {
            "type": "command",
            "key": "│ {#35}󰏖 aur     {#keys}│",
            "keyColor": "magenta",
            "text": "printf \"\\e[0m%s\\e[0m\" \"$(pacman -Qqm | wc -l)\""
        },
        {
            "type": "command",
            "key": "│ {#36}󰏖 flatpak {#keys}│",
            "keyColor": "magenta",
            "text": "printf \"\\e[0m%s\\e[0m\" \"$(flatpak list --app 2>/dev/null | wc -l)\""
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}