// Zero Trust dashboard style, inspired by ThreatLocker's fastfetch card.
// Section 1 mirrors real identity/hardware facts, section 2 mirrors the
// actual Hyprland stack running on this box, section 3 queries live
// security posture (secure boot, LUKS, firewall, MAC, lock, polkit, etc.)
// so the numbers only look as good as the machine actually is.
//
// Run with:  fastfetch -c ~/.config/fastfetch/config-zerotrust.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "/home/lufftwafedracula/.config/fastfetch/assets/atreides-face.png",
        "width": 22,
        "padding": {
            "top": 1,
            "right": 4,
            "left": 3
        }
    },
    "display": {
        "separator": " ",
        "size": {
            "binaryPrefix": "SI"
        }
    },
    "modules": [
        {
            "key": "{#36}──────────── {#39}TERMINUS{#36} ────────────",
            "type": "custom"
        },
        {
            "key": "{#36} {#39}◆{#0} User        ",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "{#36} {#39}◆{#0} Host        ",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "{#36} {#39}◆{#0} Product     ",
            "type": "os",
            "format": "{pretty-name} · Hyprland (Wayland)"
        },
        {
            "type": "custom",
            "key": "{#36} {#39}◆{#0} Doctrine    Verify Locally · Trust Nothing Blindly"
        },
        {
            "type": "command",
            "key": "{#36} {#39}◆{#0} Built       ",
            "keyColor": "cyan",
            "text": "printf \"%s days ago\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\""
        },
        {
            "key": "{#36} {#39}◆{#0} Board       ",
            "type": "board",
            "format": "{name}"
        },
        {
            "key": "{#36} {#39}◆{#0} CPU         ",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "{#36} {#39}◆{#0} GPU         ",
            "type": "gpu",
            "detectionMethod": "pci"
        },
        {
            "key": "{#36} {#39}◆{#0} Kernel      ",
            "type": "kernel"
        },
        {
            "key": "{#36} {#39}◆{#0} Uptime      ",
            "type": "uptime"
        },
        {
            "key": "{#36} {#39}◆{#0} Session     ",
            "type": "wm"
        },
        {
            "key": "{#36}────────────────────────────────────",
            "type": "custom"
        },
        {
            "key": "{#34}──────────── {#39}Platform Modules{#34} ────────────",
            "type": "custom"
        },
        {
            "type": "custom",
            "key": "{#34} {#39}▪{#0} Compositor  Hyprland"
        },
        {
            "type": "custom",
            "key": "{#34} {#39}▪{#0} Bar         Waybar"
        },
        {
            "type": "custom",
            "key": "{#34} {#39}▪{#0} Notify      SwayNC"
        },
        {
            "type": "custom",
            "key": "{#34} {#39}▪{#0} Launcher    Rofi"
        },
        {
            "type": "custom",
            "key": "{#34} {#39}▪{#0} Theming     Matugen (Material You)"
        },
        {
            "type": "custom",
            "key": "{#34} {#39}▪{#0} Idle & Lock Hypridle + Hyprlock"
        },
        {
            "key": "{#34} {#39}▪{#0} Shell       ",
            "type": "shell"
        },
        {
            "key": "{#34} {#39}▪{#0} Terminal    ",
            "type": "terminal"
        },
        {
            "key": "{#34}────────────────────────────────────",
            "type": "custom"
        },
        {
            "key": "{#32}──────────── {#39}System Load{#32} ────────────",
            "type": "custom"
        },
        {
            "type": "command",
            "key": "{#32} {#39}▸{#0} Packages    ",
            "keyColor": "green",
            "text": "printf \"%s total  \\xc2\\xb7  \\033[36m%s repo\\033[0m  \\xc2\\xb7  \\033[35m%s AUR\\033[0m  \\xc2\\xb7  \\033[34m%s flatpak\\033[0m\" \"$(( $(pacman -Qq | wc -l) + $(flatpak list --app 2>/dev/null | wc -l) ))\" \"$(pacman -Qqn | wc -l)\" \"$(pacman -Qqm | wc -l)\" \"$(flatpak list --app 2>/dev/null | wc -l)\""
        },
        {
            "key": "{#32} {#39}▸{#0} CPU Load    ",
            "type": "cpuusage"
        },
        {
            "key": "{#32} {#39}▸{#0} Memory      ",
            "type": "memory"
        },
        {
            "key": "{#32} {#39}▸{#0} Processes   ",
            "type": "processes"
        },
        {
            "key": "{#32}────────────────────────────────────",
            "type": "custom"
        },
        {
            "key": "{#36}──────────── {#39}Network{#36} ────────────",
            "type": "custom"
        },
        {
            "key": "{#36} {#39}‣{#0} Local IP    ",
            "type": "localip",
            "format": "{ipv4} ({ifName})"
        },
        {
            "key": "{#36} {#39}‣{#0} DNS         ",
            "type": "dns"
        },
        {
            "key": "{#36}────────────────────────────────────",
            "type": "custom"
        },
        {
            "key": "{#33}──────────── {#39}Storage{#33} ────────────",
            "type": "custom"
        },
        {
            "type": "command",
            "key": "{#33} {#39}◇{#0} Root (/)        ",
            "keyColor": "yellow",
            "text": "df -h --output=used,avail,pcent / | tail -1 | awk '{p=$3+0; c=(p>=90?31:(p>=75?33:32)); printf \"\\033[%dm%s free\\033[0m \\xc2\\xb7 %s used (%s)\", c,$2,$1,$3}'"
        },
        {
            "type": "command",
            "key": "{#33} {#39}◇{#0} SSD 2           ",
            "keyColor": "yellow",
            "text": "df -h --output=used,avail,pcent /mnt/seccondSSD 2>/dev/null | tail -1 | awk '{p=$3+0; c=(p>=90?31:(p>=75?33:32)); printf \"\\033[%dm%s free\\033[0m \\xc2\\xb7 %s used (%s)\", c,$2,$1,$3}'"
        },
        {
            "type": "command",
            "key": "{#33} {#39}◇{#0} HDD 1           ",
            "keyColor": "yellow",
            "text": "df -h --output=used,avail,pcent /mnt/hdd1 2>/dev/null | tail -1 | awk '{p=$3+0; c=(p>=90?31:(p>=75?33:32)); printf \"\\033[%dm%s free\\033[0m \\xc2\\xb7 %s used (%s)\", c,$2,$1,$3}'"
        },
        {
            "type": "command",
            "key": "{#33} {#39}◇{#0} HDD 2           ",
            "keyColor": "yellow",
            "text": "df -h --output=used,avail,pcent /mnt/hdd2 2>/dev/null | tail -1 | awk '{p=$3+0; c=(p>=90?31:(p>=75?33:32)); printf \"\\033[%dm%s free\\033[0m \\xc2\\xb7 %s used (%s)\", c,$2,$1,$3}'"
        },
        {
            "key": "{#33} {#39}◇{#0} Swap            ",
            "type": "swap"
        },
        {
            "key": "{#33}────────────────────────────────────",
            "type": "custom"
        },
        {
            "key": "{#35}──────────── {#39}Zero Trust Posture{#35} ────────────",
            "type": "custom"
        },
        {
            "type": "command",
            "key": "{#35} {#39}●{#0} Secure Boot     ",
            "keyColor": "magenta",
            "text": "s=$(mokutil --sb-state 2>/dev/null); if echo \"$s\" | grep -qi enabled; then printf '\\e[32mENABLED\\e[0m'; else printf '\\e[31mDISABLED\\e[0m'; fi"
        },
        {
            "type": "command",
            "key": "{#35} {#39}●{#0} Disk Encrypt    ",
            "keyColor": "magenta",
            "text": "if lsblk -o FSTYPE 2>/dev/null | grep -qi crypto_luks; then printf '\\e[32mLUKS ACTIVE\\e[0m'; else printf '\\e[31mNONE\\e[0m'; fi"
        },
        {
            "type": "command",
            "key": "{#35} {#39}●{#0} Firewall        ",
            "keyColor": "magenta",
            "text": "if systemctl is-active --quiet nftables 2>/dev/null || systemctl is-active --quiet ufw 2>/dev/null || systemctl is-active --quiet firewalld 2>/dev/null; then printf '\\e[32mENFORCED\\e[0m'; else printf '\\e[31mINACTIVE\\e[0m'; fi"
        },
        {
            "type": "command",
            "key": "{#35} {#39}●{#0} Mandatory Access",
            "keyColor": "magenta",
            "text": "if systemctl is-active --quiet apparmor 2>/dev/null; then printf '\\e[32mAPPARMOR\\e[0m'; elif [ \"$(getenforce 2>/dev/null)\" = \"Enforcing\" ]; then printf '\\e[32mSELINUX\\e[0m'; else printf '\\e[31mNONE\\e[0m'; fi"
        },
        {
            "type": "command",
            "key": "{#35} {#39}●{#0} Screen Lock     ",
            "keyColor": "magenta",
            "text": "if pgrep -x hypridle >/dev/null; then printf '\\e[32mENFORCED\\e[0m'; else printf '\\e[31mDISABLED\\e[0m'; fi"
        },
        {
            "type": "command",
            "key": "{#35} {#39}●{#0} Elevation       ",
            "keyColor": "magenta",
            "text": "if systemctl is-active --quiet polkit 2>/dev/null; then printf '\\e[32mPOLKIT ACTIVE\\e[0m'; else printf '\\e[31mUNMANAGED\\e[0m'; fi"
        },
        {
            "type": "command",
            "key": "{#35} {#39}●{#0} Pkg Signing     ",
            "keyColor": "magenta",
            "text": "lvl=$(grep -E '^SigLevel' /etc/pacman.conf 2>/dev/null | grep -o 'Required'); if [ \"$lvl\" = \"Required\" ]; then printf '\\e[32mREQUIRED\\e[0m'; else printf '\\e[33mOPTIONAL\\e[0m'; fi"
        },
        {
            "type": "command",
            "key": "{#35} {#39}●{#0} TPM             ",
            "keyColor": "magenta",
            "text": "if [ -e /dev/tpm0 ]; then printf '\\e[32mPRESENT\\e[0m'; else printf '\\e[31mABSENT\\e[0m'; fi"
        },
        {
            "type": "command",
            "key": "{#35} {#39}●{#0} SSH Server      ",
            "keyColor": "magenta",
            "text": "if systemctl is-active --quiet sshd 2>/dev/null; then printf '\\e[33mACTIVE · EXPOSED\\e[0m'; else printf '\\e[32mNOT RUNNING\\e[0m'; fi"
        },
        {
            "key": "{#35}────────────────────────────────────",
            "type": "custom"
        },
        {
            "type": "break"
        },
        {
            "key": "\"Trust is a vulnerability. Verify everything.\"",
            "type": "custom"
        }
    ]
}
