// Zero Trust identity style, inspired by ThreatLocker's fastfetch card.
// Trimmed down from the original: Platform now reads the live shell-profile
// state file instead of hardcoding the old ml4w/Waybar stack (which printed
// wrong info once Noctalia became the daily driver -- this line now follows
// the profile live). Network, the Zero-Trust-posture checks, Board, Built,
// and Processes were dropped as more than actually wanted day to day,
// keeping Storage and the Doctrine/quote bookend.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "/home/lufftwafedracula/.config/fastfetch/assets/protoss-face.png",
        "width": 22,
        "padding": {
            "top": 1,
            "right": 4,
            "left": 3
        }
    },
    "display": {
        "separator": " ",
        "size": {
            "binaryPrefix": "SI"
        }
    },
    "modules": [
        {
            "key": "{#36}──────────── {#39}TERMINUS{#36} ────────────",
            "type": "custom"
        },
        {
            "key": "{#36} {#39}◆{#0} User        ",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "{#36} {#39}◆{#0} Host        ",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "{#36} {#39}◆{#0} Product     ",
            "type": "os",
            "format": "{pretty-name} · Hyprland (Wayland)"
        },
        {
            "type": "custom",
            "key": "{#36} {#39}◆{#0} Doctrine    Verify Locally · Trust Nothing Blindly"
        },
        {
            "key": "{#36} {#39}◆{#0} CPU         ",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "{#36} {#39}◆{#0} GPU         ",
            "type": "gpu",
            "detectionMethod": "pci"
        },
        {
            "key": "{#36} {#39}◆{#0} Kernel      ",
            "type": "kernel"
        },
        {
            "key": "{#36} {#39}◆{#0} Uptime      ",
            "type": "uptime"
        },
        {
            "key": "{#36} {#39}◆{#0} Session     ",
            "type": "wm"
        },
        {
            "key": "{#36}────────────────────────────────────",
            "type": "custom"
        },
        {
            "key": "{#34}──────────── {#39}Platform{#34} ────────────",
            "type": "custom"
        },
        {
            "type": "custom",
            "key": "{#34} {#39}▪{#0} Compositor  Hyprland"
        },
        {
            "type": "command",
            "key": "{#34} {#39}▪{#0} Desktop     ",
            "text": "p=$(cat ~/.config/hypr/settings/shell-profile 2>/dev/null); if [ \"$p\" = noctalia ]; then printf 'Noctalia'; else printf 'ml4w (Waybar + SwayNC + Rofi)'; fi"
        },
        {
            "type": "custom",
            "key": "{#34} {#39}▪{#0} Theming     Matugen (Material You)"
        },
        {
            "type": "custom",
            "key": "{#34} {#39}▪{#0} Lock        Hyprlock"
        },
        {
            "key": "{#34} {#39}▪{#0} Shell       ",
            "type": "shell"
        },
        {
            "key": "{#34} {#39}▪{#0} Terminal    ",
            "type": "terminal"
        },
        {
            "key": "{#34}────────────────────────────────────",
            "type": "custom"
        },
        {
            "key": "{#32}──────────── {#39}System Load{#32} ────────────",
            "type": "custom"
        },
        {
            "type": "command",
            "key": "{#32} {#39}▸{#0} Packages    ",
            "keyColor": "green",
            "text": "printf \"%s total  \\xc2\\xb7  \\033[36m%s repo\\033[0m  \\xc2\\xb7  \\033[35m%s AUR\\033[0m  \\xc2\\xb7  \\033[34m%s flatpak\\033[0m\" \"$(( $(pacman -Qq | wc -l) + $(flatpak list --app 2>/dev/null | wc -l) ))\" \"$(pacman -Qqn | wc -l)\" \"$(pacman -Qqm | wc -l)\" \"$(flatpak list --app 2>/dev/null | wc -l)\""
        },
        {
            "key": "{#32} {#39}▸{#0} CPU Load    ",
            "type": "cpuusage"
        },
        {
            "key": "{#32} {#39}▸{#0} Memory      ",
            "type": "memory"
        },
        {
            "key": "{#32}────────────────────────────────────",
            "type": "custom"
        },
        {
            "key": "{#33}──────────── {#39}Storage{#33} ────────────",
            "type": "custom"
        },
        {
            "type": "command",
            "key": "{#33} {#39}◇{#0} Root (/)        ",
            "keyColor": "yellow",
            "text": "df -h --output=used,avail,pcent / | tail -1 | awk '{p=$3+0; c=(p>=90?31:(p>=75?33:32)); printf \"\\033[%dm%s free\\033[0m \\xc2\\xb7 %s used (%s)\", c,$2,$1,$3}'"
        },
        {
            "type": "command",
            "key": "{#33} {#39}◇{#0} SSD 2           ",
            "keyColor": "yellow",
            "text": "df -h --output=used,avail,pcent /mnt/seccondSSD 2>/dev/null | tail -1 | awk '{p=$3+0; c=(p>=90?31:(p>=75?33:32)); printf \"\\033[%dm%s free\\033[0m \\xc2\\xb7 %s used (%s)\", c,$2,$1,$3}'"
        },
        {
            "type": "command",
            "key": "{#33} {#39}◇{#0} HDD 1           ",
            "keyColor": "yellow",
            "text": "df -h --output=used,avail,pcent /mnt/hdd1 2>/dev/null | tail -1 | awk '{p=$3+0; c=(p>=90?31:(p>=75?33:32)); printf \"\\033[%dm%s free\\033[0m \\xc2\\xb7 %s used (%s)\", c,$2,$1,$3}'"
        },
        {
            "type": "command",
            "key": "{#33} {#39}◇{#0} HDD 2           ",
            "keyColor": "yellow",
            "text": "df -h --output=used,avail,pcent /mnt/hdd2 2>/dev/null | tail -1 | awk '{p=$3+0; c=(p>=90?31:(p>=75?33:32)); printf \"\\033[%dm%s free\\033[0m \\xc2\\xb7 %s used (%s)\", c,$2,$1,$3}'"
        },
        {
            "key": "{#33} {#39}◇{#0} Swap            ",
            "type": "swap"
        },
        {
            "key": "{#33}────────────────────────────────────",
            "type": "custom"
        },
        {
            "type": "break"
        },
        {
            "key": "\"Trust is a vulnerability. Verify everything.\"",
            "type": "custom"
        }
    ]
}
